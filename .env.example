# Скопируйте в .env и заполните перед docker compose up
ADMIN_NICK=admin
ADMIN_PASS=смените-этот-пароль

# Секрет для coturn (учётка zvonitel/<TURN_SECRET>)
TURN_SECRET=смените-этот-секрет

# Полный JSON-массив ICE-серверов. Строки и объекты допустимы — сервер сам нормализует.
ICE_SERVERS=[{"urls":"stun:stun.zvonitel.ru:3478"},{"urls":["turn:turn.zvonitel.ru:3478?transport=udp","turn:turn.zvonitel.ru:3478?transport=tcp"],"username":"zvonitel","credential":"смените-этот-секрет"}]
