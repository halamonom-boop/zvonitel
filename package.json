{
  "name": "zvonitel",
  "version": "1.0.0",
  "private": true,
  "description": "Zvonitel.ru — умная видеорулетка: случайные звонки 1-на-1 с подбором по интересам, языку и целям",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/matching.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "test:e2e": "node test/e2e.js",
    "test:e2e-bot": "node test/e2e-bot.js",
    "test:v2": "node test/e2e-v2.js",
    "test:mobile": "node test/e2e-mobile.js",
    "test:preview": "node test/preview-check.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:quota && npm run test:e2e && npm run test:e2e-bot && npm run test:v2 && npm run test:direct && npm run test:mobile",
    "test:quota": "node --test --test-concurrency=1 test/quota-direct.test.js",
    "test:direct": "node test/e2e-direct.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "socket.io-client": "^4.8.1"
  }
}